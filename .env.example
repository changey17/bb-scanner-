# BookieBashing credentials
BB_USERNAME=your_email@example.com
BB_PASSWORD=your_password

# Scan settings
SCAN_INTERVAL_SECONDS=120
MIN_EV_PERCENT=2.0
HEADLESS=true

# Optional: Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: API-Football key for real player stats validation
# Free tier: 100 requests/day - sign up at https://www.api-football.com
API_FOOTBALL_KEY=

# Markets to scan (comma-separated)
# Available: fouls,throw_ins,corners,cards,shots,goals,bookings
MARKETS=fouls,throw_ins,corners,cards,shots

# Bookmakers to compare (comma-separated)
# Available: bet365,paddypower,williamhill,betfred,skybet,betfair
BOOKMAKERS=bet365,paddypower,williamhill,skybet,betfair,betfred
